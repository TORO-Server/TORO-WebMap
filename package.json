{
  "name": "toro-webmap",
  "private": true,
  "type": "module",
  "description": "map.torosaba.net (Dynmap) の地図の画面と、地図のデータを TiDB から返すサーバー。3D 地図 (BlueMap) の画面は TORO-3D-WebMap",
  "scripts": {
    "build:client": "esbuild client/dynmap-client.ts --bundle --minify --format=iife --target=es2017 --outfile=public/toro/dynmap-client.js && esbuild client/sw.ts --bundle --minify --format=iife --target=es2020 --outfile=public/sw.js",
    "build": "npm run build:client && nuxt build",
    "dev": "npm run build:client && nuxt dev",
    "typecheck": "nuxt typecheck && tsc --noEmit -p client && tsc --noEmit -p client/tsconfig.sw.json && tsc --noEmit -p tools && tsc --noEmit -p tests",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "leaflet": "1.9.4",
    "mysql2": "3.24.6",
    "nuxt": "4.6.4"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/leaflet": "1.9.22",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
