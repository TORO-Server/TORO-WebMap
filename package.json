{
  "name": "toro-webmap",
  "private": true,
  "type": "module",
  "description": "map.torosaba.net (Dynmap) と 3d-map.torosaba.net (BlueMap) の地図の画面と、地図のデータを TiDB から返すサーバー",
  "scripts": {
    "build:client": "esbuild client/dynmap-client.ts --bundle --minify --format=iife --target=es2017 --outfile=public/toro/dynmap-client.js && esbuild client/sw.ts --bundle --minify --format=iife --target=es2020 --outfile=public/sw.js",
    "build": "npm run build:client && nuxt build",
    "dev": "npm run build:client && nuxt dev",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p app/bluemap/tsconfig.json && tsc --noEmit -p client && tsc --noEmit -p client/tsconfig.sw.json && tsc --noEmit -p tools && tsc --noEmit -p tests",
    "test": "node --experimental-strip-types --test \"tests/*.test.ts\""
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@sparkjsdev/spark": "2.4.0",
    "dompurify": "3.4.17",
    "fzstd": "0.1.1",
    "hammerjs": "2.0.8",
    "hls.js": "1.7.4",
    "hocon-parser": "1.0.1",
    "jpeg-js": "0.4.4",
    "jxl-oxide-wasm": "0.12.6",
    "leaflet": "1.9.4",
    "libheif-js": "1.23.5",
    "mpegts.js": "1.8.2",
    "mysql2": "3.24.6",
    "nuxt": "4.6.4",
    "pdfjs-dist": "6.5.438",
    "shaka-player": "5.3.3",
    "three": "0.187.0",
    "vue-i18n": "11.4.18"
  },
  "devDependencies": {
    "@types/hammerjs": "2.0.46",
    "@types/jsdom": "30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "sass": "1.107.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.14"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "glob": "^14.0.2"
  }
}
